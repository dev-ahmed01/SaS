APP_ENV=development
# For explicit localhost-only demo: allows username Admin (no production fallback).
LOCAL_DEMO_LOGIN_ENABLED=false
DATABASE_URL=postgresql+psycopg://sas_dev:change-me-for-local-only@localhost:5432/sas_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a secret 32+ characters for every running environment.
AUTH_SECRET=
# One-time bootstrap: provide email and organization via environment; password is prompted.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ORGANIZATION=Emlen Foundation

# Required for registering UPI identifiers. Unlike AUTH_SECRET, this must stay
# stable across authentication secret rotation; rotating it requires a migration.
UPI_MATCH_SECRET=

# Phase 11 WhatsApp/Pabbly bridge. OFF until Foundation and Meta approval.
# Setting these alone never sends messages; organization Settings must ALSO
# explicitly enable automation, and the protected delivery runner must run.
MESSAGING_DELIVERY_ENABLED=false
MESSAGING_SENDER_APPROVED=false
# Set an explicit future, timezone-aware activation instant (example only).
# MESSAGING_ENABLE_AFTER=2026-11-01T09:00:00+05:30
MESSAGING_RUNNER_SECRET=
MESSAGING_CALLBACK_SECRET=
PABBLY_SIGNATURE_SECRET=
# Must be an approved HTTPS https://connect.pabbly.com/workflow/... URL.
PABBLY_WEBHOOK_URL=
# Identifiers of approved Meta WhatsApp Business templates mapped in Pabbly.
WHATSAPP_TEMPLATE_PAYMENT=
WHATSAPP_TEMPLATE_SPONSOR=
WHATSAPP_TEMPLATE_PROMOTER=
# Separate Privacy/Foundation sign-off for disclosing sponsor arrears to promoters.
PROMOTER_DISCLOSURE_APPROVED=false
