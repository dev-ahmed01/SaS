APP_ENV=development
# For explicit localhost-only demo: allows username Admin (no production fallback).
LOCAL_DEMO_LOGIN_ENABLED=false
DATABASE_URL=postgresql+psycopg://sas_dev:change-me-for-local-only@localhost:5432/sas_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a secret 32+ characters for every running environment.
AUTH_SECRET=
# One-time bootstrap: provide email and organization via environment; password is prompted.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ORGANIZATION=Emlen Foundation

# Required for registering UPI identifiers. Unlike AUTH_SECRET, this must stay
# stable across authentication secret rotation; rotating it requires a migration.
UPI_MATCH_SECRET=

# One WhatsApp provider: Saasyto. Historic legacy dispatch rows are retained
# only for audit; there is no Pabbly webhook, worker or callback route.
# This requires an additional organization-level audited switch to run.
# Separate permission to include sponsor balances in promoter summaries.
PROMOTER_DISCLOSURE_APPROVED=false

# Sponsor phone verification (separate from payment/reminder campaigns).
# Saasyto can send the individual OTP to the selected registered prospect
# on an explicitly approved production sender. No Meta API token required.
# Local test options: strictly allowlisted 1-2 phones, OR explicit dynamic CRM
# recipient rehearsal using the isolated localhost demo database.
# In dynamic mode, recipient numbers come solely from the selected prospect
# or reviewed opted-in campaign audience, not from any environment variable.
# Confirm the provider permits authentication messages and the sender complies
# with WhatsApp policies before enabling production.
OTP_LOCAL_PILOT_ENABLED=false
# Production Saasyto individual OTP: requires production Saasyto delivery enabled,
# verified sender permissions, OTP_SECRET, and all local/Meta OTP modes OFF.
# Every request goes to that specific prospect's registered WhatsApp number.
OTP_SAASYTO_ENABLED=false
# Optional Saasyto CRM-Active acknowledgement after a successful OTP.
# OFF by default; requires documented WhatsApp update consent and an enabled
# approved Saasyto sender. This is independent of the OTP provider transport.
# It can be used with the one-number localhost OTP pilot when both are enabled.
OTP_ACTIVATION_NOTICE_ENABLED=false
# OPTIONAL ALTERNATIVE, not required when OTP_SAASYTO_ENABLED=true:
# Meta Cloud API authentication transport. Never use a Saasyto token here.
OTP_DELIVERY_ENABLED=false
# Independent 32+ character secret; keep stable while OTP challenges exist.
OTP_SECRET=
# Meta business/system-user token with WhatsApp messaging permission.
OTP_META_ACCESS_TOKEN=
OTP_META_PHONE_NUMBER_ID=
# Approved AUTHENTICATION copy-code template (not marketing/utility).
OTP_META_TEMPLATE_NAME=
OTP_META_TEMPLATE_LANGUAGE=en_US
# Pin a Graph API version supported by the connected Meta WABA account.
OTP_META_GRAPH_VERSION=v23.0

# Saasyto direct-text transport: approved OTP, Admin campaigns and monthly
# 5th/20th IST reminders. No second campaign provider is configured.
# Do NOT use the token shown in documentation screenshots.
# Never set NEXT_PUBLIC_* for these secrets. Defaults intentionally OFF.
SAASYTO_DELIVERY_ENABLED=false
SAASYTO_SENDER_APPROVED=false
# Development-only dynamic sending: independent, explicitly enabled, loopback
# sas_dev demo DB; never combine with SAASYTO_LOCAL_TEST_ENABLED or phone vars.
SAASYTO_LOCAL_DYNAMIC_ENABLED=false
# On isolated local pilot only. A second authorized number is optional.
# SAASYTO_LOCAL_TEST_ENABLED=true
# SAASYTO_LOCAL_TEST_PHONE=+91FIRST_AUTHORIZED_NUMBER
# SAASYTO_LOCAL_TEST_PHONE_2=+91SECOND_AUTHORIZED_NUMBER
SAASYTO_INSTANCE_ID=
SAASYTO_ACCESS_TOKEN=
# Activation timestamp must be in the future when first enabling, e.g. 2026-11-01T00:00:00+05:30
SAASYTO_ENABLE_AFTER=
# A unique 32+ character private runner secret for the cron/worker, not the Saasyto token.
SAASYTO_RUNNER_SECRET=

# Private production worker gates. All OFF until deployment, consent, sender
# policy and provider contract are verified. Organization automation remains
# a second independent authorization.
SAASYTO_WORKER_ENABLED=false
SAASYTO_AUTO_REMINDERS_ENABLED=false
# Conservative linked-number pacing; not a provider-confirmed API quota.
SAASYTO_CAMPAIGN_MIN_INTERVAL_SECONDS=90
SAASYTO_CAMPAIGN_BATCH_SIZE=10
SAASYTO_CAMPAIGN_MAX_PER_MINUTE=10
SAASYTO_RATE_LIMIT_PAUSE_MINUTES=15

# Optional isolated, localhost-only MySQL staging *trial*, never production:
MYSQL_STAGING_TRIAL_ENABLED=false
