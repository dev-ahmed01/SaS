APP_ENV=development
# For explicit localhost-only demo: allows username Admin (no production fallback).
LOCAL_DEMO_LOGIN_ENABLED=false
DATABASE_URL=postgresql+psycopg://sas_dev:change-me-for-local-only@localhost:5432/sas_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a secret 32+ characters for every running environment.
AUTH_SECRET=
# One-time bootstrap: provide email and organization via environment; password is prompted.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ORGANIZATION=Emlen Foundation

# Required for registering UPI identifiers. Unlike AUTH_SECRET, this must stay
# stable across authentication secret rotation; rotating it requires a migration.
UPI_MATCH_SECRET=

# Phase 11 WhatsApp/Pabbly bridge. OFF until Foundation and Meta approval.
# Setting these alone never sends messages; organization Settings must ALSO
# explicitly enable automation, and the protected delivery runner must run.
MESSAGING_DELIVERY_ENABLED=false
MESSAGING_SENDER_APPROVED=false
# Set an explicit future, timezone-aware activation instant (example only).
# MESSAGING_ENABLE_AFTER=2026-11-01T09:00:00+05:30
MESSAGING_RUNNER_SECRET=
MESSAGING_CALLBACK_SECRET=
PABBLY_SIGNATURE_SECRET=
# Must be an approved HTTPS https://connect.pabbly.com/workflow/... URL.
PABBLY_WEBHOOK_URL=
# Identifiers of approved Meta WhatsApp Business templates mapped in Pabbly.
WHATSAPP_TEMPLATE_PAYMENT=
WHATSAPP_TEMPLATE_SPONSOR=
WHATSAPP_TEMPLATE_PROMOTER=
# Separate Privacy/Foundation sign-off for disclosing sponsor arrears to promoters.
PROMOTER_DISCLOSURE_APPROVED=false

# Sponsor phone verification (separate from payment acknowledgment/reminder transport).
# Default OFF. Official Meta Cloud API only; do not paste a "Sassy" vendor key here
# unless the vendor explicitly grants first-party Meta Cloud API credentials.
OTP_DELIVERY_ENABLED=false
# When true, a verified six-digit OTP moves only newly registered, never-paid
# CRM-Inactive prospects to CRM-Active. Payment lifecycle remains unchanged.
OTP_ACTIVATES_PROSPECT=false
# Once activated, optionally send a Saasyto confirmation exactly once.
# Requires OTP activation, enabled Saasyto, and documented general-message consent.
OTP_ACTIVATION_NOTICE_ENABLED=false
# Independent 32+ character secret; keep stable while OTP challenges exist.
OTP_SECRET=
# Meta business/system-user token with WhatsApp messaging permission.
OTP_META_ACCESS_TOKEN=
OTP_META_PHONE_NUMBER_ID=
# Approved AUTHENTICATION copy-code template (not marketing/utility).
OTP_META_TEMPLATE_NAME=
OTP_META_TEMPLATE_LANGUAGE=en_US
# Pin a Graph API version supported by the connected Meta WABA account.
OTP_META_GRAPH_VERSION=v23.0

# Saasyto direct-text transport: independent from Pabbly and Meta OTP.
# Do NOT use the token shown in documentation screenshots.
# Never set NEXT_PUBLIC_* for these secrets. Defaults intentionally OFF.
SAASYTO_DELIVERY_ENABLED=false
SAASYTO_SENDER_APPROVED=false
SAASYTO_INSTANCE_ID=
SAASYTO_ACCESS_TOKEN=
# Activation timestamp must be in the future when first enabling, e.g. 2026-11-01T00:00:00+05:30
SAASYTO_ENABLE_AFTER=
# A unique 32+ character private runner secret for the cron/worker, not the Saasyto token.
SAASYTO_RUNNER_SECRET=
