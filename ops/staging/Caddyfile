{
  email {$ACME_EMAIL}
}

{$STAGING_HOST} {
  encode zstd gzip

  # The internal Next.js BFF requires a valid HTTPS API origin.
  # Public API endpoints still enforce Admin sessions, CSRF and tenant scope.
  @backend path /v1/* /health/live /health/ready
  handle @backend {
    reverse_proxy api:8001
  }
  handle {
    reverse_proxy web:3000
  }

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  log {
    output stdout
    format json
  }
}
