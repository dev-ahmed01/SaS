# This file stays on the VPS. NEVER commit it. Staging must be a separate database.
APP_ENV=staging
LOCAL_DEMO_LOGIN_ENABLED=false
# MUST enable TLS (?sslmode=require or stronger), e.g. a managed PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://SAS_STAGING_USER:REPLACE_PASSWORD@STAGING_DB_HOST:5432/sas_staging?sslmode=require
AUTH_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
UPI_MATCH_SECRET=REPLACE_WITH_DIFFERENT_48_PLUS_RANDOM_CHARACTERS
OTP_SECRET=REPLACE_WITH_ANOTHER_48_PLUS_RANDOM_CHARACTERS

# Global outbound switches are forced false by compose, even if settings are edited here.
MESSAGING_DELIVERY_ENABLED=false
MESSAGING_SENDER_APPROVED=false
OTP_DELIVERY_ENABLED=false
OTP_SAASYTO_ENABLED=false
OTP_ACTIVATION_NOTICE_ENABLED=false
SAASYTO_DELIVERY_ENABLED=false
SAASYTO_SENDER_APPROVED=false
