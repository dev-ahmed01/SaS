# Move only the approved site blocks into e.g. we.caddy / ae.caddy
# AFTER each app is available, and set WE_HOST/AE_HOST on the gateway.
{$WE_HOST} {
    encode zstd gzip
    reverse_proxy we-web:80
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

{$AE_HOST} {
    encode zstd gzip
    reverse_proxy ae-web:80
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
